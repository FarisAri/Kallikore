# NVIDIA NIM / Build API (OpenAI-compatible)
NVIDIA_API_KEY=
# Optional: comma/space separated pool for rotating article-enrichment requests.
# Keep NVIDIA_API_KEY as the primary key; additional keys go here.
NVIDIA_API_KEYS=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=moonshotai/kimi-k2-instruct
NVIDIA_ENRICH_MODEL=moonshotai/kimi-k2-instruct
# Minimum time between requests for the same NVIDIA key. Multiple keys can run in parallel.
NVIDIA_REQUEST_DELAY_MS=1200
NVIDIA_429_BACKOFF_SECONDS=5
NVIDIA_MAX_RETRIES=3
# Keep this at 1 if you are using free keys. Raise only if your quota allows it.
NVIDIA_ENRICH_CONCURRENCY=1

# World News API
WORLD_NEWS_API_KEY=

# Google Cloud Translation API (enable "Cloud Translation API", then create an API key)
GOOGLE_TRANSLATE_API_KEY=

# Python worker
PYTHON_BIN=python
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_HOME=data/huggingface
NEWS_CACHE_DIR=data/news-cache
NEWS_CACHE_MAX_AGE_DAYS=7
NEWS_DAYS_BACK=1
NEWS_RESULTS_PER_FOCUS=60
# Optional; defaults to <NEWS_CACHE_DIR>/_article_embeddings (per-article embedding vectors)
NEWS_EMBEDDING_CACHE_DIR=
# Optional; defaults to <NEWS_CACHE_DIR>/_nvidia_enrichment (AI reason + map pin location)
NVIDIA_ENRICH_CACHE_DIR=
