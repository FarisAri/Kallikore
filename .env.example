# NVIDIA NIM / Build API (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=moonshotai/kimi-k2-instruct
NVIDIA_ENRICH_MODEL=moonshotai/kimi-k2-instruct

# World News API
WORLD_NEWS_API_KEY=

# Python worker
PYTHON_BIN=python
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_HOME=data/huggingface
NEWS_CACHE_DIR=data/news-cache
NEWS_CACHE_MAX_AGE_DAYS=7
NEWS_DAYS_BACK=1
NEWS_RESULTS_PER_FOCUS=60
